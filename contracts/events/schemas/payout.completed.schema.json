{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anchorpay.local/events/payout.completed.schema.json",
  "title": "payout.completed (v1)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "eventType": {
      "const": "payout.completed"
    },
    "eventVersion": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payoutId",
        "transferId",
        "partnerPayoutId",
        "completedAt"
      ],
      "properties": {
        "payoutId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "transferId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "partnerPayoutId": {
          "type": "string"
        },
        "completedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
