{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anchorpay.local/events/kyc.approved.schema.json",
  "title": "kyc.approved (v1)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "eventType": {
      "const": "kyc.approved"
    },
    "eventVersion": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "kycRecordId",
        "tier",
        "approvedAt"
      ],
      "properties": {
        "userId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "kycRecordId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "tier": {
          "$ref": "common.schema.json#/$defs/kycTier"
        },
        "approvedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
