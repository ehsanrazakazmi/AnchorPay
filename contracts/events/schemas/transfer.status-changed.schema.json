{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anchorpay.local/events/transfer.status-changed.schema.json",
  "title": "transfer.status-changed (v1)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "eventType": {
      "const": "transfer.status-changed"
    },
    "eventVersion": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferId",
        "reference",
        "userId",
        "fromStatus",
        "toStatus",
        "changedAt",
        "sendAmount",
        "receiveAmount"
      ],
      "properties": {
        "transferId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "reference": {
          "$ref": "common.schema.json#/$defs/transferReference"
        },
        "userId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "fromStatus": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/transferStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "toStatus": {
          "$ref": "common.schema.json#/$defs/transferStatus"
        },
        "changedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "sendAmount": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "receiveAmount": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "unevaluatedProperties": false
}
