{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anchorpay.local/events/payout.failed.schema.json",
  "title": "payout.failed (v1)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "eventType": {
      "const": "payout.failed"
    },
    "eventVersion": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payoutId",
        "transferId",
        "attempts",
        "reasonCode",
        "final",
        "failedAt"
      ],
      "properties": {
        "payoutId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "transferId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "reasonCode": {
          "enum": [
            "invalid_account",
            "recipient_bank_rejected",
            "partner_unavailable",
            "limit_exceeded",
            "other"
          ]
        },
        "final": {
          "type": "boolean",
          "description": "false = moved to the manual queue; true = give up, transfer fails and is refunded."
        },
        "failedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
