{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anchorpay.local/events/dlq.schema.json",
  "title": "Dead-letter message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "originalTopic",
    "originalPartition",
    "originalOffset",
    "consumer",
    "attempts",
    "error",
    "failedAt",
    "originalValue"
  ],
  "properties": {
    "originalTopic": {
      "type": "string"
    },
    "originalPartition": {
      "type": "integer",
      "minimum": 0
    },
    "originalOffset": {
      "type": "string"
    },
    "originalKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "consumer": {
      "type": "string"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "stack": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "failedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "originalValue": {
      "description": "The original envelope (or raw string if it was not valid JSON)."
    }
  }
}
