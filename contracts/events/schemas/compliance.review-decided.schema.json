{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anchorpay.local/events/compliance.review-decided.schema.json",
  "title": "compliance.review-decided (v1)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "eventType": {
      "const": "compliance.review-decided"
    },
    "eventVersion": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewCaseId",
        "transferId",
        "decision",
        "decidedBy",
        "decidedAt"
      ],
      "properties": {
        "reviewCaseId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "transferId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "decidedBy": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "decidedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
