# AnchorPay local environment — template.
# Copy with `npm run setup:env -- --pg-superuser-password=<your postgres password>`.
# That creates .env (git-ignored) and fills every __GENERATE__ value with a random secret.
# Never put real secrets in this file.

# ---------------------------------------------------------------- environment
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# ---------------------------------------------------------------- PostgreSQL (18, local)
PGHOST=127.0.0.1
PGPORT=5433
PG_DATABASE=anchorpay
# Superuser is only used by `npm run db:bootstrap` to create roles + database.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=__ASK__
# Owns every table; used only to run migrations.
PG_MIGRATOR_USER=ap_migrator
PG_MIGRATOR_PASSWORD=__GENERATE__
# One least-privilege login per service (see docs/database.md#roles).
PG_CORE_USER=ap_core
PG_CORE_PASSWORD=__GENERATE__
PG_COMPLIANCE_USER=ap_compliance
PG_COMPLIANCE_PASSWORD=__GENERATE__
PG_FX_USER=ap_fx
PG_FX_PASSWORD=__GENERATE__
PG_PAYMENTS_USER=ap_payments
PG_PAYMENTS_PASSWORD=__GENERATE__
PG_LEDGER_USER=ap_ledger
PG_LEDGER_PASSWORD=__GENERATE__
PG_NOTIFY_USER=ap_notify
PG_NOTIFY_PASSWORD=__GENERATE__
# Read-only role for reporting/analytics queries.
PG_REPORTING_USER=ap_reporting
PG_REPORTING_PASSWORD=__GENERATE__

# ---------------------------------------------------------------- Redis protocol (Garnet locally)
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------- Kafka
# Use 127.0.0.1, not localhost: Kafka listens on IPv4 only and Windows tries ::1 first.
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID_PREFIX=anchorpay
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1

# ---------------------------------------------------------------- service ports (docs/architecture.md)
WEB_PORT=3000
GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=4001
TRANSFER_SERVICE_PORT=4002
PAYMENT_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004
COMPLIANCE_SERVICE_PORT=5001
FX_SERVICE_PORT=5002
LEDGER_SERVICE_PORT=5003
MOCK_PROVIDERS_PORT=4900
API_DOCS_PORT=8090

# ---------------------------------------------------------------- auth
JWT_ISSUER=anchorpay-identity
JWT_AUDIENCE=anchorpay-api
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Shared secret services use to call each other's /internal APIs (X-Internal-Token header).
INTERNAL_SERVICE_TOKEN=__GENERATE__

# ---------------------------------------------------------------- application-layer encryption (PII)
# AES-256-GCM key (32 bytes, base64) and a separate HMAC-SHA256 key for searchable "blind index" hashes.
PII_ENCRYPTION_KEY_ID=k1
PII_ENCRYPTION_KEY=__GENERATE_KEY32__
PII_HMAC_KEY=__GENERATE_KEY32__

# ---------------------------------------------------------------- external providers (free mocks by default)
KYC_PROVIDER=mock
SANCTIONS_PROVIDER=local-lists
PAYOUT_PROVIDER=mock
# mock | stripe  (stripe = Stripe TEST mode only: sk_test_... keys, free, no card needed to sign up)
CARD_PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_DEBIT_PROVIDER=mock
MOCK_PROVIDERS_URL=http://127.0.0.1:4900
MOCK_WEBHOOK_SECRET=__GENERATE__
# log = write messages to logs/ instead of sending real SMS/email (zero cost)
SMS_PROVIDER=log
EMAIL_PROVIDER=log

# ---------------------------------------------------------------- FX rates
# open-er-api: free, no API key, updated daily. The service adds a small simulated movement every
# poll so rate-lock behaviour can be tested. mock = fully offline fixed rates.
FX_RATE_SOURCE=open-er-api
FX_RATE_SOURCE_URL=https://open.er-api.com/v6/latest/CAD
FX_POLL_INTERVAL_SECONDS=30
FX_CACHE_TTL_SECONDS=60
FX_SIMULATED_JITTER_BPS=5
FX_LOCK_TTL_SECONDS=1800

# ---------------------------------------------------------------- local tooling
# Portable Java / Kafka / Garnet install (see docs/local-setup.md)
DEVTOOLS_DIR=C:/Users/ehsan/devtools
